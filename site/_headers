# Cloudflare Pages response headers for every path. Pages load nothing from
# another origin and carry no inline code (tools/build_site.py audits both, and
# checks this policy); the home page runs its own module scripts, fetches its
# three foe models (connect-src) and plays clips and sound only from this site,
# so the policy allows only this site's own files.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; media-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
