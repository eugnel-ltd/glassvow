+static bool _texture_mip_upload_layout(uint32_t p_width, uint32_t p_height, uint32_t p_depth, uint32_t p_block_w, uint32_t p_block_h, uint32_t p_block_bytes, uint32_t p_pixel_size, uint32_t p_pixel_rshift, uint32_t p_pitch_step, uint32_t p_alignment, uint64_t &r_pitch, uint64_t &r_slice_stride, uint64_t &r_mip_bytes) {
+	const uint64_t limit = 4 * 1024 * 1024;
+	if (p_width == 0 || p_height == 0 || p_depth == 0 || p_block_w == 0 || p_block_h == 0 || p_pixel_rshift >= 32 || p_pitch_step == 0 || p_alignment == 0 || p_alignment > limit) {
+		return false;
+	}
+	if (p_width % p_block_w != 0 || p_height % p_block_h != 0) {
+		return false;
+	}
+	const uint32_t unit = (p_block_w != 1 || p_block_h != 1) ? p_block_bytes : p_pixel_size;
+	const uint64_t tight_row = uint64_t(p_width / p_block_w) * unit;
+	r_pitch = (uint64_t(p_width) * p_pixel_size * p_block_w) >> p_pixel_rshift;
+	r_pitch = ((r_pitch + p_pitch_step - 1) / p_pitch_step) * p_pitch_step;
+	if (tight_row == 0 || r_pitch < tight_row || r_pitch > limit) {
+		return false;
+	}
+	const uint64_t slice = r_pitch * (p_height / p_block_h);
+	if (slice == 0 || slice > limit) {
+		return false;
+	}
+	r_slice_stride = ((slice + p_alignment - 1) / p_alignment) * p_alignment;
+	if (uint64_t(p_depth - 1) > (limit - slice) / r_slice_stride) {
+		return false;
+	}
+	r_mip_bytes = r_slice_stride * (p_depth - 1) + slice;
+	return true;
+}
