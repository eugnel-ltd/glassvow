@@ -96,6 +96,17 @@ bool ShaderBakerExportPlugin::_begin_customize_resources(const Ref<EditorExportP
 		return false;
 	}
 
+	// Glassvow #682: the renderer resolved these settings with this process's features when
+	// it started, and they shape the scene shaders' cache keys and code. A target that
+	// resolves them otherwise (iOS: `.mobile`) would never load the bake: refuse it. Start
+	// the export with GODOT_EDITOR_CUSTOM_FEATURES naming the target's features ("mobile").
+	for (const char *setting : { "rendering/reflections/sky_reflections/texture_array_reflections", "rendering/shading/overrides/force_lambert_over_burley" }) {
+		if (get_export_preset()->get_project_setting(setting) != GLOBAL_GET(setting)) {
+			ERR_PRINT(vformat("Shader baker: \"%s\" differs for this export target; set GODOT_EDITOR_CUSTOM_FEATURES to its features. Shaders not baked.", setting));
+			return false;
+		}
+	}
+
 	if (!_initialize_container_format(p_platform, get_export_preset())) {
 		return false;
 	}
@@ -140,6 +151,16 @@ bool ShaderBakerExportPlugin::_begin_customize_resources(const Ref<EditorExportP
 
 	RendererSceneRenderRD::get_singleton()->enable_features(renderer_features);
 
+	// Glassvow #682: the engine's own shaders (its renderers', effects' and embedded materials')
+	// are not baked. Their bake's picture could not be tested on the floor device, whose user
+	// cache, read first, always held their runtime compile; a fresh install compiles them as an
+	// unbaked build does. Set this true to bake them again, once their identity is proven on a
+	// fresh app container.
+	constexpr bool bake_engine_shaders = false;
+	if (!bake_engine_shaders) {
+		return true;
+	}
+
 	// Included all shaders created by renderers and effects.
