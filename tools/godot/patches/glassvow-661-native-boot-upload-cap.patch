 /* BACKGROUND */
 
+// Native PNG boot images bypass the resource importer. Bound their initial
+// uploads without changing their source pixels or the full-image screen rect.
+struct BootImageSlice {
+	Ref<Image> image;
+	Rect2 source_rect = Rect2(0, 0, 1, 1);
+	int first_row = 0;
+	int end_row = 0;
+};
+
+inline Vector<BootImageSlice> get_boot_image_slices(const Ref<Image> &p_image, bool p_repeat) {
+	Vector<BootImageSlice> slices;
+	ERR_FAIL_COND_V(p_image.is_null() || p_image->is_empty(), slices);
+	const int width = p_image->get_width();
+	const int height = p_image->get_height();
+	const Image::Format format = p_image->get_format();
+	const uint64_t limit = 4 * 1024 * 1024;
+	const bool native_png = !p_image->has_mipmaps() &&
+			(format == Image::FORMAT_L8 || format == Image::FORMAT_LA8 || format == Image::FORMAT_RGB8 || format == Image::FORMAT_RGBA8);
+	// Keep other callers of the Image-based API unchanged; Main's PNG loader
+	// produces only the four formats above, with no mipmaps.
+	if (!native_png || uint64_t(width) * height * 4 <= limit) {
+		BootImageSlice slice;
+		slice.image = p_image;
+		slice.end_row = height;
+		slices.push_back(slice);
+		return slices;
+	}
+	// RGB8 expands to RGBA8 on RD. Reserve both linear-filter neighbors even
+	// on GLES so all native PNG pages satisfy the same conservative ceiling.
+	const int owned_rows = int(limit / (uint64_t(width) * 4)) - 2;
+	ERR_FAIL_COND_V(owned_rows < 1, slices);
+	const int count = (height + owned_rows - 1) / owned_rows;
+	for (int i = 0; i < count; i++) {
+		BootImageSlice slice;
+		slice.first_row = int(int64_t(i) * height / count);
+		slice.end_row = int(int64_t(i + 1) * height / count);
+		const int rows = slice.end_row - slice.first_row;
+		const int top = (p_repeat || slice.first_row > 0) ? 1 : 0;
+		const int bottom = (p_repeat || slice.end_row < height) ? 1 : 0;
+		const int upload_rows = rows + top + bottom;
+		slice.image = Image::create_empty(width, upload_rows, false, format);
+		slice.image->blit_rect(p_image, Rect2i(0, slice.first_row, width, rows), Point2i(0, top));
+		if (top) {
+			const int row = (slice.first_row + height - 1) % height;
+			slice.image->blit_rect(p_image, Rect2i(0, row, width, 1), Point2i(0, 0));
+		}
+		if (bottom) {
+			const int row = slice.end_row % height;
+			slice.image->blit_rect(p_image, Rect2i(0, row, width, 1), Point2i(0, top + rows));
+		}
+		slice.source_rect = Rect2(0, real_t(top) / upload_rows, 1, real_t(rows) / upload_rows);
+		slices.push_back(slice);
+	}
+	return slices;
+}
+
+inline Rect2 get_boot_image_slice_screen_rect(const Rect2 &p_full_rect, const BootImageSlice &p_slice, int p_image_height) {
+	const real_t first = p_full_rect.position.y + p_full_rect.size.y * (real_t(p_slice.first_row) / p_image_height);
+	const real_t end = p_full_rect.position.y + p_full_rect.size.y * (real_t(p_slice.end_row) / p_image_height);
+	return Rect2(p_full_rect.position.x, first, p_full_rect.size.x, end - first);
+}
