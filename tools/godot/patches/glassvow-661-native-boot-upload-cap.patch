+void CopyEffects::copy_to_rect_from_rect(const Rect2 &p_dst, const Rect2 &p_src) {
+	bool success = copy.shader.version_bind_shader(copy.shader_version, CopyShaderGLES3::MODE_COPY_SECTION_SOURCE);
+	if (!success) {
+		return;
+	}
+	copy.shader.version_set_uniform(CopyShaderGLES3::COPY_SECTION, p_dst.position.x, p_dst.position.y, p_dst.size.x, p_dst.size.y, copy.shader_version, CopyShaderGLES3::MODE_COPY_SECTION_SOURCE);
+	copy.shader.version_set_uniform(CopyShaderGLES3::SOURCE_SECTION, p_src.position.x, p_src.position.y, p_src.size.x, p_src.size.y, copy.shader_version, CopyShaderGLES3::MODE_COPY_SECTION_SOURCE);
+	draw_screen_quad();
+}
