+#pragma once
+
+#include "servers/rendering/rendering_server_types.h"
+#include "tests/test_macros.h"
+
+namespace TestBootImageSlices {
+TEST_SUITE("GlassvowBootUpload") {
+TEST_CASE("Native PNG pages preserve owned pixels, gutters and 4 MiB bound") {
+	Vector<uint8_t> pixels;
+	pixels.resize(2360 * 1640 * 3);
+	uint8_t *bytes = pixels.ptrw();
+	for (int i = 0; i < pixels.size(); i++) {
+		bytes[i] = uint8_t((i * 37 + i / 2360) % 251);
+	}
+	Ref<Image> image = Image::create_from_data(2360, 1640, false, Image::FORMAT_RGB8, pixels);
+	CHECK(image->get_data_size() > 4 * 1024 * 1024);
+	for (int repeat_case = 0; repeat_case < 2; repeat_case++) {
+		const bool repeat = repeat_case == 1;
+		Vector<RenderingServerTypes::BootImageSlice> slices = RenderingServerTypes::get_boot_image_slices(image, repeat);
+		REQUIRE(slices.size() == 4);
+		int owned_rows = 0;
+		for (int i = 0; i < slices.size(); i++) {
+			const auto &slice = slices[i];
+			const int top = (repeat || i > 0) ? 1 : 0;
+			const int rows = slice.end_row - slice.first_row;
+			CHECK(slice.first_row == owned_rows);
+			CHECK(slice.image->get_width() == 2360);
+			CHECK(slice.image->get_height() * 2360 * 4 <= 4 * 1024 * 1024);
+			CHECK_FALSE(slice.image->has_mipmaps());
+			const Vector<uint8_t> page = slice.image->get_data();
+			for (int y = 0; y < slice.image->get_height(); y++) {
+				const int source_row = (slice.first_row + y - top + 1640) % 1640;
+				CHECK(memcmp(page.ptr() + y * 2360 * 3, pixels.ptr() + source_row * 2360 * 3, 2360 * 3) == 0);
+			}
+			owned_rows += rows;
+		}
+		CHECK(owned_rows == 1640);
+	}
+}
+TEST_CASE("RGBA transparent colors and signed destination geometry are retained") {
+	Vector<uint8_t> pixels;
+	pixels.resize(2048 * 513 * 4);
+	uint8_t *bytes = pixels.ptrw();
+	for (int i = 0; i < pixels.size(); i++) {
+		bytes[i] = uint8_t((i * 13 + i / 2048) % 256);
+	}
+	Ref<Image> image = Image::create_from_data(2048, 513, false, Image::FORMAT_RGBA8, pixels);
+	Vector<RenderingServerTypes::BootImageSlice> slices = RenderingServerTypes::get_boot_image_slices(image, true);
+	REQUIRE(slices.size() == 2);
+	Rect2 full(-0.2, 1.1, 1.4, -1.2);
+	real_t last = full.position.y;
+	for (const auto &slice : slices) {
+		const Vector<uint8_t> page = slice.image->get_data();
+		for (int y = 0; y < slice.image->get_height(); y++) {
+			const int source_row = (slice.first_row + y - 1 + 513) % 513;
+			CHECK(memcmp(page.ptr() + y * 2048 * 4, pixels.ptr() + source_row * 2048 * 4, 2048 * 4) == 0);
+		}
+		CHECK(slice.image->get_data_size() <= 4 * 1024 * 1024);
+		const Rect2 rect = RenderingServerTypes::get_boot_image_slice_screen_rect(full, slice, 513);
+		CHECK(Math::is_equal_approx(rect.position.y, last));
+		CHECK(rect.position.x == full.position.x);
+		CHECK(rect.size.x == full.size.x);
+		last = rect.position.y + rect.size.y;
+	}
+	CHECK(Math::is_equal_approx(last, full.position.y + full.size.y));
+}
+TEST_CASE("Small images and non-PNG Image callers keep their original image") {
+	const Image::Format formats[] = { Image::FORMAT_L8, Image::FORMAT_LA8, Image::FORMAT_RGB8, Image::FORMAT_RGBA8, Image::FORMAT_RGBAF };
+	for (const auto format : formats) {
+		Ref<Image> image = Image::create_empty(5, 3, false, format);
+		const auto slices = RenderingServerTypes::get_boot_image_slices(image, true);
+		REQUIRE(slices.size() == 1);
+		CHECK(slices[0].image == image);
+		CHECK(slices[0].source_rect == Rect2(0, 0, 1, 1));
+		CHECK(slices[0].first_row == 0);
+		CHECK(slices[0].end_row == 3);
+	}
+}
